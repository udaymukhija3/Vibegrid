{
  "title": "VibeGrid Production",
  "tags": ["vibegrid", "launch"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "App up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "vibegrid_up{job=\"vibegrid\"}",
          "legendFormat": "up"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(vibegrid_http_requests_total{job=\"vibegrid\"}[5m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx responses",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(vibegrid_http_requests_total{job=\"vibegrid\",status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 request latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vibegrid_http_request_duration_seconds_bucket{job=\"vibegrid\"}[5m])) by (le, route))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Status by route",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(vibegrid_http_requests_total{job=\"vibegrid\"}[5m])) by (route, status)",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Response bandwidth",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(vibegrid_http_response_bytes_total{job=\"vibegrid\"}[5m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Runtime memory",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "vibegrid_process_heap_alloc_bytes{job=\"vibegrid\"}",
          "legendFormat": "heap alloc"
        },
        {
          "expr": "vibegrid_process_sys_bytes{job=\"vibegrid\"}",
          "legendFormat": "runtime sys"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB pool waits",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "rate(vibegrid_db_wait_count_total{job=\"vibegrid\"}[5m])",
          "legendFormat": "waits/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Storage operation latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vibegrid_store_operation_duration_seconds_bucket{job=\"vibegrid\"}[5m])) by (le, component, operation))",
          "legendFormat": "{{component}} {{operation}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Storage errors",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(vibegrid_store_operations_total{job=\"vibegrid\",status=\"error\"}[5m])) by (component, operation)",
          "legendFormat": "{{component}} {{operation}}"
        }
      ]
    }
  ]
}
